generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  identifier String?
  token      String
  expires    DateTime

  @@unique([email, token])
}

model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @db.ObjectId
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

model User {
  id                      String          @id @default(auto()) @map("_id") @db.ObjectId
  name                    String?
  firstName               String?
  lastName                String?
  email                   String          @unique
  country                 String?
  phonenumber             String?
  emailVerified           DateTime?
  image                   String?
  password                String?
  notificationPreferences Json? // e.g., { "email": true, "sms": false }
  roleId                  String?         @db.ObjectId
  role                    Role?           @relation(fields: [roleId], references: [id])
  accounts                Account[]
  sessions                Session[]
  Authenticator           Authenticator[]
  invitationsSent         Invitation[]
  borrows                 Borrow[]
  reservations            Reservation[]
  publications            Publication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
}

/// Dynamic, admin-manageable role — rows an admin creates/edits/deletes at
/// runtime (matches the live CRUD pattern the mock at
/// app/dashboard/roles/_components/roles-data.ts + use-roles.ts already
/// implements), not a static Prisma enum. auth-context.tsx's mock UserRole
/// ("admin"/"manager"/"staff"/"member") is the seed vocabulary this
/// collection should be populated with once wired up for real.
model Role {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String?
  permissions String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  invitations Invitation[]
}

/// Email invitation to join the platform with a specific Role — mirrors
/// app/dashboard/invitations/_components/invitations-data.ts's Invitation
/// shape, with `role: string` replaced by a real `roleId` FK (the mock's
/// `role` was a free-text union matched only by spelling against Role.name,
/// confirmed via invitation-schema.ts's `invitableRoles`).
model Invitation {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  email           String
  roleId          String           @db.ObjectId
  role            Role             @relation(fields: [roleId], references: [id])
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?          @db.ObjectId
  invitedBy       User?            @relation(fields: [invitedByUserId], references: [id])
  sentAt          DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

/// Append-only audit trail, per RULES.md §10. Keeps the mock's
/// human-readable `actor`/`target`/`notes` snapshot fields (an audit log
/// should still read sensibly after the entity it describes is later
/// renamed or deleted) but adds real `actorId`/`targetId`/`targetType` so
/// entries are also genuinely joinable — the mock at
/// app/dashboard/audit-log/_components/audit-log-data.ts has zero id
/// fields today, only free text.
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actor      String
  actorId    String?  @db.ObjectId
  action     String
  target     String
  targetId   String?  @db.ObjectId
  targetType String?
  ipAddress  String?
  notes      String?
  timestamp  DateTime @default(now())
}

/// Canonical Kingdom Classification System (KCS) taxonomy — one flat,
/// self-referencing collection for both the 8 root pillars and their ~75
/// child scrolls (Bible books), mirroring `lib/kcs-taxonomy`'s already-
/// consolidated `Category` shape (itself the result of merging 3
/// previously hand-duplicated mock copies — see that module's own
/// docstring). `parentId: null` marks a root; root-only content fields
/// (`code`/`subtitle`/`range`/`theme`/`description`/`detail`/`heroImage`)
/// are left null on children, and `status` (leaf-only) is left null on
/// roots, matching the mock's optional-field convention exactly.
///
/// Kept as ONE collection (not split into separate Pillar/Scroll models)
/// because every real consumer (KCS Map, admin Categories CRUD, member
/// library, public library filter) already walks this as one tree via
/// `parentId`, and a scroll needs independent querying/filtering/search
/// separate from its parent pillar (ruling out embedding children inside
/// their root document).
model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  slug        String     @unique
  nameEn      String
  nameFr      String
  nameRw      String
  parentId    String?    @db.ObjectId
  parent      Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryToParent")
  /// KCS classification code, e.g. "KCS-FND". Roots only.
  code        String?
  /// Tagline, e.g. "Constitution of the Kingdom". Roots only.
  subtitle    String?
  /// Book span covered by this pillar, e.g. "Genesis – Deuteronomy". Roots only.
  range       String?
  /// Theme phrase, e.g. "Origins and Covenant". Roots only.
  theme       String?
  /// One-sentence description. Roots only.
  description String?
  /// Longer descriptive paragraph. Roots only.
  detail      String?
  /// Hero/header image URL. Roots only.
  heroImage   String?
  /// Availability status. Leaf/scroll rows only.
  status      CategoryStatus?
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum CategoryStatus {
  AVAILABLE
  ARCHIVED
  OUT_OF_STOCK
}

/// Digital library resource — a "scroll" filed under a KCS category.
/// Mirrors `app/dashboard/library/_components/resources-data.ts`'s
/// `Resource` shape exactly, with `categoryId` now a real `@db.ObjectId`
/// FK (the mock's own docstring already documents this field as "FK into
/// the canonical KCS taxonomy," replacing an even-older free-text
/// `category: string` from before that merge — this schema is the final
/// step of making that FK real, not a new decision).
model Resource {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  author       String
  publisher    String
  /// Optional as of Phase 4: published books (see Publication.status
  /// PUBLISHED, which auto-creates a Resource row on approval) use a
  /// free-text category vocabulary (Theology, Leadership, etc.) that
  /// doesn't map onto the KCS Bible taxonomy — forcing a categoryId here
  /// would misrepresent the taxonomy rather than honestly reflect that
  /// these are two different classification systems. Every Resource
  /// created before Phase 4 (all 16 KCS scrolls) already has a real
  /// categoryId and is unaffected by this widening.
  categoryId   String?      @db.ObjectId
  category     Category?    @relation(fields: [categoryId], references: [id])
  type         String
  format       String
  language     String
  year         Int
  pages        Int
  isbn         String
  price        Float
  totalQty     Int
  availableQty Int
  status       ResourceStatus @default(AVAILABLE)
  coverImages  String[]
  bindingType  BindingType
  mediaType    MediaType
  description  String
  tags         String[]
  documentUrl  String?
  audioUrl     String?
  videoUrl     String?
  borrows      Borrow[]
  reservations Reservation[]
  /// Not truly one-to-many in practice — exactly one Publication ever
  /// points at a given Resource, set once at approval time — but Prisma
  /// requires a list back-relation for a non-unique FK (see
  /// Publication.resourceId's docstring for why @unique doesn't work
  /// here). List type is a Prisma-modeling artifact, not a real
  /// multi-publication-per-resource case.
  publications Publication[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ResourceStatus {
  AVAILABLE
  OUT_OF_STOCK
  ARCHIVED
}

enum BindingType {
  SOFT
  HARD
}

enum MediaType {
  VIDEO
  DOCUMENT
  TEXT
  COMBINATION
}

/// Real borrow record, replacing the two disconnected mock stores found
/// at app/dashboard/library/borrowings/_components/borrowings-data.ts
/// (admin, free-text memberName/memberEmail alongside an unresolved
/// memberId, no resourceId at all) and
/// app/member/borrowings/_components/borrowings-data.ts (member, numeric
/// id, title/author only, no ids whatsoever). Both collapse into this one
/// collection with real userId/resourceId FKs, per the migration plan's
/// Phase 3 design. `memberName`/`memberEmail` are kept as point-in-time
/// snapshot fields (so a borrow record still reads sensibly if the user's
/// name/email later changes) alongside the real userId FK, not instead of
/// it — same pattern already used for AuditLog's actor/actorId.
model Borrow {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id])
  memberName    String
  memberEmail   String
  resourceId    String       @db.ObjectId
  resource      Resource     @relation(fields: [resourceId], references: [id])
  borrowDate    DateTime     @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  status        BorrowStatus @default(PENDING)
  renewalCount  Int          @default(0)
  fineAmount    Float?
  finePaid      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum BorrowStatus {
  PENDING
  ACTIVE
  OVERDUE
  RETURNED
  REJECTED
}

/// Real reservation record, replacing the two disconnected mock stores at
/// app/dashboard/reservations/_components/reservations-data.ts (admin —
/// its resourceId values like "res-3" were confirmed NOT to match any
/// real Resource.id, a fabricated-looking FK) and
/// app/member/reservations/_components/reservations-data.ts (member,
/// numeric id, title/author only). `queuePosition` is kept as a real,
/// stored field (not computed on read) so the existing claim-countdown
/// and queue-promotion-by-title logic (see use-reservations.ts's
/// fulfillReservation) has a direct field to update, matching how the
/// mock already modeled it.
model Reservation {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id])
  memberName      String
  memberEmail     String
  resourceId      String            @db.ObjectId
  resource        Resource          @relation(fields: [resourceId], references: [id])
  queuePosition   Int
  reservationDate DateTime          @default(now())
  notifiedAt      DateTime?
  claimDeadline   DateTime?
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum ReservationStatus {
  PENDING
  NOTIFIED
  CLAIMED
  EXPIRED
  CANCELLED
}

/// Real publication submission, replacing
/// app/dashboard/publishing/review/_components/review-data.ts's
/// PublicationSubmission — already a single, unified mock store (unlike
/// Borrowing/Reservation, the contributor/admin submission stores were
/// already merged before this migration, so there's no duplicate-store
/// problem to resolve here). A PUBLISHED Publication IS the catalog
/// entry (replacing the separate PublishedBook/catalog-data.ts mock
/// entirely) — the public/admin catalog reads Publication rows filtered
/// by status, rather than a second parallel model. Approving a
/// submission (status -> PUBLISHED) auto-creates a matching Resource row
/// (see app/api/publications/[id]/route.ts's approve action), the real
/// relationship the migration plan flagged as missing from the mock
/// entirely — resourceId is populated only once that happens.
/// `category` stays free text (not a KCS categoryId): confirmed the
/// mock's categories (Theology, Leadership, Family & Marriage...) are a
/// different, non-Bible classification system than the KCS taxonomy —
/// forcing them into KCS pillars would misrepresent the taxonomy rather
/// than honestly reflect they're separate systems, the same judgment
/// call kls-architecture-rules already made for e-learning's category
/// field.
model Publication {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  contributorId  String            @db.ObjectId
  contributor    User              @relation(fields: [contributorId], references: [id])
  contributorName String
  category       String
  language       PublicationLanguage @default(EN)
  coverImage     String?
  description    String
  status         PublicationStatus @default(DRAFT)
  /// Real Resource FK, populated when this Publication is approved and
  /// published — see the model docstring above.
  /// Not @unique: MongoDB/Prisma's sparse-unique-index behavior treats
  /// multiple null values as colliding (confirmed empirically — seeding
  /// a second Publication with no resourceId yet threw P2002 against the
  /// first's null), which is wrong for a field that's null for every
  /// non-published row. One-to-one-ness is enforced at the application
  /// level instead: resourceId is only ever set once, inside the
  /// approve-action transaction in app/api/publications/[id]/route.ts.
  resourceId     String?           @db.ObjectId
  resource       Resource?         @relation(fields: [resourceId], references: [id])
  /// Sale price and stock, only meaningful once PUBLISHED — mirrors
  /// catalog-data.ts's PublishedBook.price/quantity/bindingType/mediaType,
  /// which had no equivalent on the pre-publish submission.
  price          Float?
  quantity       Int?
  bindingType    BindingType?
  mediaType      MediaType?
  featured       Boolean           @default(false)
  submittedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  revenueShare   RevenueShare?
}

enum PublicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum PublicationLanguage {
  EN
  FR
  RW
}

/// Per-publication revenue split, replacing
/// app/dashboard/publishing/revenue/_components/revenue-data.ts's
/// RevenueRow (`publication`/`contributor` free text with no FK at all).
/// One-to-one with Publication (a row is created only once, at
/// approval time, mirroring the mock's own addRevenueRowForApproval) —
/// kept as its own collection rather than embedded fields on Publication
/// since Task 5.3's earnings/revenue reporting needs independent
/// date-range queries across all publications' revenue, per the
/// migration plan's own reasoning for this domain.
model RevenueShare {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  publicationId     String      @unique @db.ObjectId
  publication       Publication @relation(fields: [publicationId], references: [id])
  contributorShare  Int
  platformShare     Int
  totalRevenue      Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}
