DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/<database-name>"
NEXT_PUBLIC_BASE_URL=http://localhost:3000/
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

NEXTAUTH_URL=http://localhost:3000/
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_DEBUG=false

SALTROUNDS=10
ACCESS_TOKEN_EXP_TIME=172800000
JWT_SECRET="generate-a-real-random-secret"
REFRESH_TOKEN_EXP_TIME=2592000000

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

PAYPACK_APPLICATION_ID="your-paypack-application-id"
PAYPACK_APPLICATION_SECRET="your-paypack-application-secret"
PAYPACK_WEBHOOK_SECRET="your-paypack-webhook-secret"
PAYPACK_WEBHOOK_MODE=development

USD_TO_RWF_RATE=1450

# Card checkout for course enrollment and paid Borrow/Reservation access
# orders (Stripe test mode — see lib/stripe.ts). Without these, the "Pay
# with Card" option 503s; PayPack checkout is unaffected.
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

GOOGLE_EMAIL="your-gmail-address@gmail.com"
GOOGLE_PASSWORD="your-gmail-app-password"

CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Real-time video/audio for session rooms (LiveKit Cloud — cloud.livekit.io).
# Without these, the session room falls back to the local-only mock.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Professional online dictionary for the markdown editor's spellcheck
# (LanguageTool — proxied server-side via /api/spellcheck). The free public
# endpoint (api.languagetool.org/v2/check) is used when these are unset and
# needs no key but is rate-limited (~20 requests/75KB per minute, 20KB per
# request); the editor falls back to its offline dictionary on any failure.
# Set both to use the premium LanguageTool API with higher limits.
LANGUAGETOOL_API_KEY=""
LANGUAGETOOL_USERNAME=""

# Separate database for the test suite (never production). Then: npm run test:db-setup
TEST_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/kls_db_test"

# ── Payment providers (lib/payments) ─────────────────────────────────────────
# Each one appears at checkout only when its variables are set AND an admin
# switches it on at /dashboard/settings/payments. *_ENV=production uses the live
# API; anything else uses the provider's sandbox. Callback URLs to register with
# each provider are shown on that admin page.

# IntouchPay (MTN MoMo + Airtel Money)
INTOUCH_USERNAME=
INTOUCH_ACCOUNT_NO=
INTOUCH_PARTNER_PASSWORD=
INTOUCH_ENV=sandbox

# MTN MoMo Collection API (direct)
MTN_MOMO_COLLECTION_PRIMARY_KEY=
MTN_MOMO_REFERENCE_ID=
MTN_MOMO_API_KEY=
# optional: defaults to the Rwanda proxy / "mtnrwanda" / RWF
MTN_MOMO_BASE_URL=
MTN_MOMO_ENVIRONMENT=
MTN_MOMO_CURRENCY=

# PesaPal API 3.0 (hosted checkout: card, mobile money, ...)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
# optional: an IPN id you registered yourself; otherwise it is registered automatically once
PESAPAL_IPN_ID=

# UrubutoPay v2
URUBUTOPAY_API_KEY=
URUBUTOPAY_MERCHANT_CODE=
URUBUTOPAY_SERVICE_CODE=
URUBUTOPAY_WEBHOOK_TOKEN=
URUBUTOPAY_ENV=sandbox
